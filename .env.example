# SDD Trainer configuration
# Copy to .env and fill in your keys:  cp .env.example .env
# .env is git-ignored — never commit real keys.

# cloud.ru OpenAI-compatible API key for GigaChat (required, ADR-005)
GIGACHAT_KEY=

# Tavily search API key for the search_sdd_docs tool (optional, ADR-006)
TAVILY_API_KEY=

# (Optional) Logging
# LOG_LEVEL=INFO
