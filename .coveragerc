[run]
source =
    sdd_trainer
omit =
    tests/*
    .venv/*
    */site-packages/*
    */__pycache__/*
    */test_*
    */conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    pass
show_missing = True
precision = 2
fail_under = 40

[html]
directory = htmlcov
